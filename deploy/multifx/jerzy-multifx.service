[Unit]
Description=Jerzy Audio - MultiFX DSP (Compressor, Drive, Tremolo, Memory Delay)
Requires=jerzy-jack.service
After=jerzy-jack.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=jerzy
Group=audio
WorkingDirectory=/home/jerzy/JerzyMultiFX
Environment=HOME=/home/jerzy
LimitRTPRIO=95
LimitMEMLOCK=infinity
ExecStartPre=/bin/sh -c 'i=0; until /usr/bin/jack_lsp 2>/dev/null | /usr/bin/grep -qx system:playback_1; do i=$((i+1)); [ "$i" -lt 40 ] || exit 1; sleep 1; done'
ExecStart=/home/jerzy/JerzyMultiFX/build-multifx/JerzyMultiFXJACK
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
