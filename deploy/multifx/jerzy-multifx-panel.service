[Unit]
Description=Jerzy Audio - MultiFX mobile browser controller
Requires=jerzy-multifx.service
After=jerzy-multifx.service NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=jerzy
Group=audio
WorkingDirectory=/home/jerzy/JerzyMultiFX
Environment=HOME=/home/jerzy
Environment=JERZY_MULTIFX_BIND=10.42.0.1
ExecStart=/usr/bin/python3 /home/jerzy/JerzyMultiFX/multifx/web_panel.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
