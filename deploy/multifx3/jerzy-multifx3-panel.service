[Unit]
Description=Jerzy Audio - v0.3 touch control panel
Requires=jerzy-multifx3.service
After=jerzy-multifx3.service NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=jerzy
Group=audio
WorkingDirectory=/home/jerzy/JerzyMultiFX3
Environment=HOME=/home/jerzy
Environment=JERZY_MULTIFX2_BIND=10.42.0.1
Environment=JERZY_MULTIFX2_PORT=8091
Environment=JERZY_MULTIFX2_MODULE_DIR=/home/jerzy/JerzyMultiFX3/build-multifx2/modules
Environment=JERZY_MULTIFX2_DATA_DIR=/home/jerzy/.config/jerzy-multifx3
ExecStart=/usr/bin/python3 /home/jerzy/JerzyMultiFX3/multifx2/web_panel.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
