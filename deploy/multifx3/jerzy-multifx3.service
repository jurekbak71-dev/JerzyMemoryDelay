[Unit]
Description=Jerzy Audio - MultiFX v0.3 (modular JACK audio engine)
Requires=jerzy-jack.service
After=jerzy-jack.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=jerzy
Group=audio
WorkingDirectory=/home/jerzy/JerzyMultiFX3
Environment=HOME=/home/jerzy
LimitRTPRIO=95
LimitMEMLOCK=infinity
ExecStartPre=/bin/sh -c 'i=0; until /usr/bin/jack_lsp 2>/dev/null | /usr/bin/grep -qx system:playback_1; do i=$((i+1)); [ "$i" -lt 40 ] || exit 1; sleep 1; done'
ExecStart=/home/jerzy/JerzyMultiFX3/build-multifx2/JerzyMultiFX2JACK --modules /home/jerzy/JerzyMultiFX3/build-multifx2/modules
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
