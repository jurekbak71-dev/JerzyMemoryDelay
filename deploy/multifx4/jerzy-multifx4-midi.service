[Unit]
Description=Jerzy MultiFX 0.4 - hotplug JACK MIDI routing
Requires=jerzy-multifx4.service
After=jerzy-multifx4.service

[Service]
Type=simple
User=jerzy
Group=audio
WorkingDirectory=/home/jerzy/JerzyMultiFX4
ExecStart=/bin/sh /home/jerzy/JerzyMultiFX4/deploy/multifx4/midi-connect.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
